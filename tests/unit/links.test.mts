import { normalizeUrl, sourceOf } from "../../src/lib/links.ts";
let pass = 0, fail = 0;
const ok = (n: string, c: unknown) => { if (c) pass++; else { fail++; console.log("FAIL", n); } };
ok("full drive", normalizeUrl(" https://drive.google.com/drive/folders/abc?usp=sharing ") === "https://drive.google.com/drive/folders/abc?usp=sharing");
ok("adds https", normalizeUrl("drive.google.com/file/d/1") === "https://drive.google.com/file/d/1");
ok("http refused", normalizeUrl("http://drive.google.com/x") === null);
ok("javascript refused", normalizeUrl("javascript:alert(1)") === null);
ok("data refused", normalizeUrl("data:text/html,hi") === null);
ok("mailto refused", normalizeUrl("mailto:a@b.co") === null);
ok("no dot refused", normalizeUrl("localhost/x") === null);
ok("spaces refused", normalizeUrl("https://a.co/a b") === null);
ok("empty", normalizeUrl("   ") === null);
ok("too long", normalizeUrl("https://a.co/" + "x".repeat(2100)) === null);
ok("matches db rule", /^https:\/\/\S+$/i.test(normalizeUrl("docs.google.com/document/d/1/edit")!));
ok("source drive", sourceOf("https://drive.google.com/x") === "Google Drive" && sourceOf("https://docs.google.com/x") === "Google Drive");
ok("source dropbox", sourceOf("https://www.dropbox.com/s/x") === "Dropbox");
ok("source onedrive", sourceOf("https://acme-my.sharepoint.com/x") === "OneDrive");
ok("source other", sourceOf("https://www.example.com/x") === "example.com");
ok("no spoof", sourceOf("https://drive.google.com.evil.co/x") === "drive.google.com.evil.co");
console.log(`${pass}/${pass + fail} passed`);
process.exit(fail ? 1 : 0);
